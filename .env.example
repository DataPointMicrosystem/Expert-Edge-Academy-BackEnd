# Server
PORT=1023
NODE_ENV=development
FRONTEND_URL=https://expertedgeacademy.vercel.app
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=1h

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/expertedge_academy
# If mongodb+srv DNS fails on the deployment host, use Atlas's direct seed-list URI:
# MONGODB_URI=mongodb://user:password@host-00-00.example.mongodb.net:27017,host-00-01.example.mongodb.net:27017,host-00-02.example.mongodb.net:27017/?authSource=admin&replicaSet=replica-set-name&tls=true&retryWrites=true&w=majority

# Email (Brevo)
brevo_api_key=
BREVO_SENDER_EMAIL=noreply@expertedgeacademy.com
BREVO_SENDER_NAME=ExpertEdge Academy

# OAuth (optional for local email/password development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALL_BACK_URL=http://localhost:1023/api/auth/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Media (used in course-management phase)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_BYTES=209715200

# Payments (used in payment phase)
PAYMENT_PROVIDER=kora
KORA_API_URL=https://api.korapay.com
KORA_SECRET_KEY=
KORA_PUBLIC_KEY=
KORA_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_URL=https://your-api-domain.example.com/api/payments/webhook
# Korapay-compatible aliases and identity verification settings
KORAPAY_SECRET_KEY=
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1/identities/ng
KORAPAY_API_BASE_URL=https://api.korapay.com/merchant/api/v1
KORAPAY_WEBHOOK_URL=https://your-api-domain.example.com/api/payments/webhook
KORAPAY_ENCRYPTION_KEY=
PLATFORM_FEE_PERCENTAGE=15
